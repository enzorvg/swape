# Copy to .env (never committed) and adjust. Local dev values only: no real secret here.

# --- API ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://swape:swape@localhost:5434/swape
TEST_DATABASE_URL=postgresql+asyncpg://swape:swape@localhost:5435/swape_test
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=["http://localhost:5173"]

# --- Web (Vite exposes only VITE_* variables to the browser) ---
VITE_API_URL=http://localhost:8000

# --- Mobile (Expo exposes only EXPO_PUBLIC_* variables) ---
# On a physical device, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
